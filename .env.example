# Runtime server environment; set through your hosting dashboard.
PORT=3000
DATA_DIR=var
# SQLite is the default on your laptop. On Render, use the private Neon
# pooled connection string; never commit its real value or share it in chat.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLED-HOST/neondb?sslmode=require
# REQUIRE_POSTGRES=1
# Free Render has no shell: these private fields create the first admin once.
# Choose your own username and password (16–128 characters); no defaults.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# Remove BOTH bootstrap fields after the first successful deployment.
# Serve app downloads from GitHub Releases when packages are absent locally.
# APP_RELEASE_TAG=v1.5.0
# Optional additional trusted browser origins, comma-separated.
# Native Android https://localhost is already allowed.
CORS_ORIGINS=
# Optional build-time Android API default; can also be entered in the app.
# VITE_API_URL=https://your-game.example
